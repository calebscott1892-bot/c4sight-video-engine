{
  "name": "c4sight-video-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts C4SightMotionTest out/c4sight-motion-test.mp4 --codec=h264",
    "render:stylelab": "remotion render src/index.ts C4SightStyleLab out/c4sight-style-lab.mp4 --codec=h264",
    "render:teaching-beat": "remotion render src/index.ts C4SightTeachingBeatTest out/c4sight-teaching-beat-test.mp4 --codec=h264",
    "render:teaching-beat-v2": "remotion render src/index.ts C4SightTeachingBeatTestV2 out/c4sight-teaching-beat-test-v2.mp4 --codec=h264",
    "render:magic-hook-burst": "remotion render src/index.ts C4SightMagicHookBurst out/c4sight-magic-hook-burst.mp4 --codec=h264",
    "render:episode01-cold-open": "remotion render src/index.ts C4SightEpisode01ColdOpen out/c4sight-episode01-cold-open.mp4 --codec=h264",
    "render:episode01-cold-open-v2": "remotion render src/index.ts C4SightEpisode01ColdOpenV2 out/c4sight-episode01-cold-open-v2.mp4 --codec=h264",
    "render:episode01-animatic": "remotion render src/index.ts C4SightEpisode01-Animatic out/c4sight-episode01-animatic.mp4 --codec=h264",
    "render:design-system-preview": "remotion render src/index.ts C4SightDesignSystemPreview out/c4sight-design-system-preview.mp4 --codec=h264",
    "render:design-system-preview-v2": "remotion render src/index.ts C4SightDesignSystemPreviewV2 out/c4sight-design-system-preview-v2.mp4 --codec=h264",
    "render:external-design-system-preview": "remotion render src/index.ts C4SightExternalDesignSystemPreview out/c4sight-external-design-system-preview.mp4 --codec=h264",
    "c4sight:assets": "npm run assets:scan",
    "c4sight:qa": "node scripts/c4sight-production-qa.mjs",
    "c4sight:qa:assets": "npm run assets:scan && node scripts/validate-c4sight-assets.mjs",
    "c4sight:qa:design-system": "node scripts/check-c4sight-design-system-package.mjs",
    "c4sight:qa:gates": "node scripts/check-c4sight-production-gates.mjs",
    "c4sight:qa:episode01": "node scripts/check-episode01-plan.mjs",
    "assets:scan": "node scripts/update-c4sight-asset-readiness.mjs",
    "render:asset-readiness-preview": "npm run assets:scan && remotion render src/index.ts C4SightAssetReadinessPreview out/c4sight-asset-readiness-preview.mp4 --codec=h264",
    "render:preview": "remotion still src/index.ts C4SightMotionTest out/preview.png --frame=160",
    "render:stylelab-preview": "remotion still src/index.ts C4SightStyleLab out/c4sight-style-lab-preview.png --frame=430",
    "render:descenders-preview": "remotion still src/index.ts ChalkTextDescenderPreview out/chalk-text-descenders-preview.png --frame=90",
    "render:teaching-beat-preview": "remotion still src/index.ts C4SightTeachingBeatTest out/c4sight-teaching-beat-preview.png --frame=540",
    "render:teaching-beat-v2-preview": "remotion still src/index.ts C4SightTeachingBeatTestV2 out/c4sight-teaching-beat-v2-preview.png --frame=540",
    "render:magic-hook-burst-preview": "remotion still src/index.ts C4SightMagicHookBurst out/c4sight-magic-hook-burst-preview.png --frame=450",
    "render:episode01-cold-open-preview": "remotion still src/index.ts C4SightEpisode01ColdOpen out/c4sight-episode01-cold-open-preview.png --frame=660",
    "render:episode01-cold-open-v2-preview": "remotion still src/index.ts C4SightEpisode01ColdOpenV2 out/c4sight-episode01-cold-open-v2-preview.png --frame=660",
    "render:episode01-animatic-preview": "remotion still src/index.ts C4SightEpisode01-Animatic out/c4sight-episode01-animatic-preview.png --frame=900",
    "render:design-system-preview-still": "remotion still src/index.ts C4SightDesignSystemPreview out/c4sight-design-system-preview-still.png --frame=540",
    "render:design-system-preview-v2-still": "remotion still src/index.ts C4SightDesignSystemPreviewV2 out/c4sight-design-system-preview-v2-still.png --frame=540",
    "render:external-design-system-preview-still": "remotion still src/index.ts C4SightExternalDesignSystemPreview out/c4sight-external-design-system-preview-still.png --frame=360",
    "render:asset-readiness-preview-still": "npm run assets:scan && remotion still src/index.ts C4SightAssetReadinessPreview out/c4sight-asset-readiness-preview-still.png --frame=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@c4sight/design-system": "file:packages/c4sight-design-system",
    "@remotion/cli": "latest",
    "@remotion/google-fonts": "4.0.458",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
